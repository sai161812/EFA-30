{
  "manifest_version": 3,
  "name": "EFA-30",
  "version": "1.0.0",
  "description": "Review and approve autofill suggestions from your local profiles or optional POD-16 profiles.",
  "action": {
    "default_title": "Scan this form",
    "default_popup": "extension/popup.html",
    "default_icon": "extension/icons/efa-30-logo.png"
  },
  "background": {
    "service_worker": "extension/service-worker.js",
    "type": "module"
  },
  "options_page": "extension/settings.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "minimum_chrome_version": "106",
  "icons": {
    "16": "extension/icons/efa-30-logo.png",
    "32": "extension/icons/efa-30-logo.png",
    "48": "extension/icons/efa-30-logo.png",
    "128": "extension/icons/efa-30-logo.png"
  }
}
