{
  "manifest_version": 3,
  "name": "PLUMA Autofill (Development)",
  "version": "0.2.0",
  "description": "A review-first form autofill development prototype.",
  "action": {
    "default_title": "Scan this form",
    "default_popup": "extension/popup.html"
  },
  "background": {
    "service_worker": "extension/service-worker.js",
    "type": "module"
  },
  "options_page": "extension/settings.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}
